local Players = game:GetService("Players")
local player = Players.LocalPlayer

local parent = (gethui and gethui()) or game:GetService("CoreGui")
local okParent = pcall(function() return parent.Name end)
if not okParent then parent = player:WaitForChild("PlayerGui") end

local gui = Instance.new("ScreenGui")
gui.Name = "FarTeleport"
gui.ResetOnSpawn = false
gui.Parent = parent

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 230, 0, 165)
frame.Position = UDim2.new(0.5, -115, 0.15, 0)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
frame.Active = true
frame.Draggable = true
frame.Parent = gui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

local function mk(class, props, corner)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    if corner then Instance.new("UICorner", o).CornerRadius = UDim.new(0, 6) end
    o.Parent = frame
    return o
end

mk("TextLabel", {
    Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1,
    Text = "Далёкие острова", TextColor3 = Color3.new(1, 1, 1),
    Font = Enum.Font.GothamBold, TextSize = 15,
})

local box = mk("TextBox", {
    Size = UDim2.new(0.8, 0, 0, 30), Position = UDim2.new(0.1, 0, 0, 30),
    BackgroundColor3 = Color3.fromRGB(50, 50, 50), TextColor3 = Color3.new(1, 1, 1),
    PlaceholderText = "Расстояние, студы (1-100000)", Text = "50000",
    ClearTextOnFocus = false, Font = Enum.Font.Gotham, TextSize = 13,
}, true)

local goBtn = mk("TextButton", {
    Size = UDim2.new(0.8, 0, 0, 30), Position = UDim2.new(0.1, 0, 0, 68),
    BackgroundColor3 = Color3.fromRGB(0, 150, 80), Text = "Телепорт вперёд",
    TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBold, TextSize = 14,
}, true)

local backBtn = mk("TextButton", {
    Size = UDim2.new(0.8, 0, 0, 30), Position = UDim2.new(0.1, 0, 0, 104),
    BackgroundColor3 = Color3.fromRGB(170, 50, 50), Text = "Назад",
    TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBold, TextSize = 14,
}, true)

local info = mk("TextLabel", {
    Size = UDim2.new(0.9, 0, 0, 20), Position = UDim2.new(0.05, 0, 0, 138),
    BackgroundTransparency = 1, Text = "Смотри в нужную сторону",
    TextColor3 = Color3.fromRGB(200, 200, 200), Font = Enum.Font.Gotham, TextSize = 11,
})

local saved, platform

local function getHrp()
    local c = player.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

goBtn.MouseButton1Click:Connect(function()
    local hrp = getHrp()
    if not hrp then return end
    local n = tonumber(box.Text)
    if not n then info.Text = "Нужно число!" return end
    n = math.clamp(n, 1, 100000)

    saved = hrp.CFrame
    local look = workspace.CurrentCamera.CFrame.LookVector
    local dir = Vector3.new(look.X, 0, look.Z)
    if dir.Magnitude < 0.1 then dir = Vector3.new(0, 0, -1) end
    dir = dir.Unit

    local target = hrp.Position + dir * n

    if platform then platform:Destroy() end
    platform = Instance.new("Part")
    platform.Size = Vector3.new(200, 2, 200)
    platform.Anchored = true
    platform.Transparency = 0.5
    platform.Color = Color3.fromRGB(80, 160, 255)
    platform.Position = target - Vector3.new(0, 4, 0)
    platform.Parent = workspace

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.CFrame = CFrame.new(target, target + dir)
    info.Text = "Телепорт: " .. n .. " студов"
end)

backBtn.MouseButton1Click:Connect(function()
    local hrp = getHrp()
    if hrp and saved then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.CFrame = saved
        if platform then platform:Destroy() platform = nil end
        info.Text = "Вернулся"
    end
end)
